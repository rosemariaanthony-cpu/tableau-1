      <column caption='Borough (taxi zone lookup.csv1)' datatype='string' name='[Borough (taxi_zone_lookup.csv1)]' role='dimension' type='nominal' />
      <column caption='trip time ' datatype='integer' name='[Calculation_0952784877604864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;minute&apos;,[lpep_pickup_datetime], [lpep_dropoff_datetime])' />
      </column>
      <column caption='time of day' datatype='string' name='[Calculation_0952784881737729]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;hour&apos;,[lpep_pickup_datetime]) &gt;= 5 AND DATEPART(&apos;hour&apos;,[lpep_pickup_datetime]) &lt;= 10&#13;&#10;THEN &quot;Morning&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;,[lpep_pickup_datetime]) &gt;=11 AND DATEPART(&apos;hour&apos;,[lpep_pickup_datetime]) &lt;= 16&#13;&#10;THEN &quot;Afternoon&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;,[lpep_pickup_datetime]) &gt;= 17 AND DATEPART(&apos;hour&apos;,[lpep_pickup_datetime]) &lt;= 21&#13;&#10;THEN &quot;Evening&quot;&#13;&#10;ELSE &quot;Latenight&quot;&#13;&#10;END' />
      </column>
      <column caption='Top 5 Parameter' datatype='real' name='[Calculation_0952784889085956]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 0952784888008706]&#13;&#10;WHEN &quot;Average Renvenue&quot; THEN AVG([total_amount])&#13;&#10;WHEN &quot;Average Tip Amount&quot; THEN AVG([tip_amount])&#13;&#10;END' />
      </column>
